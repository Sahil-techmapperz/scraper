  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "category": {"name": "category", "in": "query", "schema": {"type": "string", "enum": ["cars", "bikes", "mobile-phones", "real-estate", "jobs", "software-engineer", "data-scientist", "devops-engineer", "product-manager", "frontend-developer", "backend-developer", "full-stack-developer", "qa-engineer", "marketing", "sales", "hr", "finance"]}},
      "subcategory": {"name": "subcategory", "in": "query", "schema": {"type": "string"}},
      "keyword": {"name": "keyword", "in": "query", "schema": {"type": "string", "maxLength": 120}},
      "state": {"name": "state", "in": "query", "schema": {"type": "string"}},
      "city": {"name": "city", "in": "query", "schema": {"type": "string"}},
      "locality": {"name": "locality", "in": "query", "schema": {"type": "string"}},
      "pincode": {"name": "pincode", "in": "query", "schema": {"type": "string", "pattern": "^\\d{6}$"}},
      "min_price": {"name": "min_price", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "max_price": {"name": "max_price", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "sort": {"name": "sort", "in": "query", "schema": {"type": "string", "enum": ["newest", "oldest", "price_low_to_high", "price_high_to_low"]}},
      "page": {"name": "page", "in": "query", "schema": {"type": "integer", "default": 1, "minimum": 1}},
      "limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "default": 50, "minimum": 1, "maximum": 100}},
      "posted_from": {"name": "posted_from", "in": "query", "schema": {"type": "string", "format": "date"}},
      "posted_to": {"name": "posted_to", "in": "query", "schema": {"type": "string", "format": "date"}},
      "fresh": {"name": "fresh", "in": "query", "schema": {"type": "boolean", "default": false}},
      "vehicle_type": {"name": "vehicle_type", "in": "query", "schema": {"type": "string"}},
      "brand": {"name": "brand", "in": "query", "schema": {"type": "string"}},
      "model": {"name": "model", "in": "query", "schema": {"type": "string"}},
      "variant": {"name": "variant", "in": "query", "schema": {"type": "string"}},
      "min_year": {"name": "min_year", "in": "query", "schema": {"type": "integer"}},
      "max_year": {"name": "max_year", "in": "query", "schema": {"type": "integer"}},
      "fuel_type": {"name": "fuel_type", "in": "query", "schema": {"type": "string", "enum": ["petrol", "diesel", "cng", "electric", "hybrid", "lpg"]}},
      "transmission": {"name": "transmission", "in": "query", "schema": {"type": "string", "enum": ["manual", "automatic"]}},
      "min_km": {"name": "min_km", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "max_km": {"name": "max_km", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "owner_count": {"name": "owner_count", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "condition": {"name": "condition", "in": "query", "schema": {"type": "string", "enum": ["new", "used", "refurbished"]}},
      "min_ram": {"name": "min_ram", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "max_ram": {"name": "max_ram", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "min_storage": {"name": "min_storage", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "max_storage": {"name": "max_storage", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "warranty": {"name": "warranty", "in": "query", "schema": {"type": "string", "enum": ["yes", "no"]}},
      "listing_type": {"name": "listing_type", "in": "query", "schema": {"type": "string", "enum": ["sale", "rent"]}},
      "property_type": {"name": "property_type", "in": "query", "schema": {"type": "string"}},
      "property_category": {"name": "property_category", "in": "query", "schema": {"type": "string"}},
      "bhk": {"name": "bhk", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "min_area": {"name": "min_area", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "max_area": {"name": "max_area", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "furnishing": {"name": "furnishing", "in": "query", "schema": {"type": "string", "enum": ["furnished", "semi-furnished", "unfurnished"]}},
      "posted_by": {"name": "posted_by", "in": "query", "schema": {"type": "string", "enum": ["owner", "dealer", "builder", "agent"]}},
      "experience": {"name": "experience", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "min_experience": {"name": "min_experience", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "max_experience": {"name": "max_experience", "in": "query", "schema": {"type": "integer", "minimum": 0}},
      "skills": {"name": "skills", "in": "query", "schema": {"type": "string"}},
      "company": {"name": "company", "in": "query", "schema": {"type": "string"}},
      "salary_range": {"name": "salary_range", "in": "query", "schema": {"type": "string"}}
    },
    "schemas": {
      "SearchResponse": {
        "type": "object",
        "required": ["success", "source", "request", "pagination", "data"],
        "properties": {
          "success": {"type": "boolean", "const": true},
          "source": {"$ref": "#/components/schemas/Source"},
          "request": {"type": "object", "additionalProperties": true},
          "pagination": {"$ref": "#/components/schemas/Pagination"},
          "data": {"type": "array", "items": {"$ref": "#/components/schemas/Listing"}}
        }
      },
      "DetailResponse": {
        "type": "object",
        "required": ["success", "source", "data"],
        "properties": {
          "success": {"type": "boolean", "const": true},
          "source": {"$ref": "#/components/schemas/Source"},
          "data": {"$ref": "#/components/schemas/Listing"}
        }
      },
      "Source": {
        "type": "object",
        "properties": {
          "platform": {"type": "string", "example": "olx"},
          "country": {"type": "string", "example": "IN"}
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {"type": "integer"},
          "limit": {"type": "integer"},
          "has_next": {"type": "boolean"}
        }
      },
      "Listing": {
        "type": "object",
        "properties": {
          "listing_id": {"type": "string"},
          "listing_url": {"type": ["string", "null"], "format": "uri"},
          "title": {"type": ["string", "null"]},
          "description": {"type": ["string", "null"]},
          "category": {"type": ["string", "null"]},
          "subcategory": {"type": ["string", "null"]},
          "price": {"$ref": "#/components/schemas/Price"},
          "seller": {"$ref": "#/components/schemas/Seller"},
          "location": {"$ref": "#/components/schemas/Location"},
          "automobile": {"$ref": "#/components/schemas/Automobile"},
          "mobile_phone": {"$ref": "#/components/schemas/MobilePhone"},
          "real_estate": {"$ref": "#/components/schemas/RealEstate"},
          "job": {"$ref": "#/components/schemas/Job"},
          "images": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "listing_date": {"type": ["string", "null"], "format": "date"},
          "last_updated": {"type": ["string", "null"], "format": "date-time"},
          "availability": {"type": "string"},
          "collected_at": {"type": "string", "format": "date-time"}
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "company_name": {"type": ["string", "null"]},
          "experience_required": {"type": ["string", "null"]},
          "salary_text": {"type": ["string", "null"]},
          "skills": {"type": "array", "items": {"type": "string"}},
          "company_rating": {"type": ["number", "null"]},
          "review_count": {"type": ["string", "null"]},
          "posted_age": {"type": ["string", "null"]},
          "apply_url": {"type": ["string", "null"], "format": "uri"}
        }
      },
      "Price": {
