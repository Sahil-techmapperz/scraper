    "/api/v1/admin/usage": {

      "get": {
        "summary": "Admin API usage report",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent usage logs and monthly summary"
          },
