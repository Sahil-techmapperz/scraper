{
  "openapi": "3.1.0",
  "info": {
    "title": "Marketplace & Job Live Data Extraction API",
    "version": "1.3.0",
    "description": "Authenticated multi-platform API for normalized real-time listing search and detail data extraction across OLX India (Classifieds), CarDekho (Automotive), Naukri.com (Jobs & Careers), and Cashify.in (Refurbished Gadgets & Electronics)."
  },

  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "security": [],
        "summary": "Service health and source adapter status",
        "responses": {
          "200": {
            "description": "Health status"
          }
        }
      }
    },
    "/api/v1/olx/listings": {
      "get": {
        "summary": "Search OLX India listings",
        "parameters": [
          {"$ref": "#/components/parameters/category"},
          {"$ref": "#/components/parameters/subcategory"},
          {"$ref": "#/components/parameters/keyword"},
          {"$ref": "#/components/parameters/state"},
          {"$ref": "#/components/parameters/city"},
          {"$ref": "#/components/parameters/locality"},
          {"$ref": "#/components/parameters/pincode"},
          {"$ref": "#/components/parameters/min_price"},
          {"$ref": "#/components/parameters/max_price"},
          {"$ref": "#/components/parameters/sort"},
          {"$ref": "#/components/parameters/page"},
          {"$ref": "#/components/parameters/limit"},
          {"$ref": "#/components/parameters/posted_from"},
          {"$ref": "#/components/parameters/posted_to"},
          {"$ref": "#/components/parameters/fresh"},
          {"$ref": "#/components/parameters/vehicle_type"},
          {"$ref": "#/components/parameters/brand"},
          {"$ref": "#/components/parameters/model"},
          {"$ref": "#/components/parameters/variant"},
          {"$ref": "#/components/parameters/min_year"},
          {"$ref": "#/components/parameters/max_year"},
          {"$ref": "#/components/parameters/fuel_type"},
          {"$ref": "#/components/parameters/transmission"},
          {"$ref": "#/components/parameters/min_km"},
          {"$ref": "#/components/parameters/max_km"},
          {"$ref": "#/components/parameters/owner_count"},
          {"$ref": "#/components/parameters/condition"},
          {"$ref": "#/components/parameters/min_ram"},
          {"$ref": "#/components/parameters/max_ram"},
          {"$ref": "#/components/parameters/min_storage"},
          {"$ref": "#/components/parameters/max_storage"},
          {"$ref": "#/components/parameters/warranty"},
          {"$ref": "#/components/parameters/listing_type"},
          {"$ref": "#/components/parameters/property_type"},
          {"$ref": "#/components/parameters/property_category"},
          {"$ref": "#/components/parameters/bhk"},
          {"$ref": "#/components/parameters/min_area"},
          {"$ref": "#/components/parameters/max_area"},
          {"$ref": "#/components/parameters/furnishing"},
          {"$ref": "#/components/parameters/posted_by"}
        ],
        "responses": {
          "200": {
            "description": "Normalized listing collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "502": {"$ref": "#/components/responses/SourceUnavailable"},
          "504": {"$ref": "#/components/responses/SourceTimeout"}
        }
      }
    },
    "/api/v1/olx/listings/{listing_id}": {
      "get": {
        "summary": "Fetch current listing detail by source listing ID",
        "parameters": [
          {
            "name": "listing_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {"$ref": "#/components/parameters/fresh"}
        ],
        "responses": {
          "200": {
            "description": "Normalized listing detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailResponse"
                }
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "502": {"$ref": "#/components/responses/SourceUnavailable"}
        }
      }
    },
    "/api/v1/olx/listing": {
      "get": {
        "summary": "Fetch listing detail by URL when the configured source connector supports it",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {"$ref": "#/components/parameters/fresh"}
        ],
        "responses": {
          "200": {
            "description": "Normalized listing detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailResponse"
                }
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "502": {"$ref": "#/components/responses/SourceUnavailable"}
        }
      }
    },
