CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8085/'

database.default.database = data-api.sqlite
database.default.DBDriver = SQLite3
database.default.DBPrefix =
database.default.foreignKeys = true

API_KEY_PEPPER = local-dev-only-pepper
API_DEFAULT_LIMIT = 50
API_MAX_LIMIT = 300
API_RATE_LIMIT = 100
API_MONTHLY_QUOTA = 10000
API_USAGE_LOGGING = true
BOOTSTRAP_API_KEY = dev-local-api-key

# Redis / Cache Configuration
CACHE_HANDLER = predis
CACHE_BACKUP_HANDLER = file
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD =
REDIS_DATABASE = 0

SOURCE_COUNTRY = IN

# OLX Configuration
OLX_CONNECTOR_MODE = authorized_http
OLX_AUTHORIZED_API_BASE_URL = http://127.0.0.1:8000
OLX_SEARCH_ENDPOINT = /olx/listings
OLX_DETAIL_ENDPOINT = /olx/listings/{listing_id}
OLX_REQUEST_TIMEOUT = 30
OLX_RETRY_ATTEMPTS = 2
OLX_CACHE_ENABLED = true
OLX_CACHE_TTL = 300

# CarDekho Configuration
CARDEKHO_CONNECTOR_MODE = authorized_http
CARDEKHO_AUTHORIZED_API_BASE_URL = http://127.0.0.1:8000
CARDEKHO_SEARCH_ENDPOINT = /cardekho/listings
CARDEKHO_DETAIL_ENDPOINT = /cardekho/listings/{listing_id}
CARDEKHO_REQUEST_TIMEOUT = 30
CARDEKHO_RETRY_ATTEMPTS = 2
CARDEKHO_CACHE_ENABLED = true
CARDEKHO_CACHE_TTL = 300

# Naukri Configuration
NAUKRI_CONNECTOR_MODE = authorized_http
NAUKRI_AUTHORIZED_API_BASE_URL = http://127.0.0.1:8000
NAUKRI_SEARCH_ENDPOINT = /naukri/listings
NAUKRI_DETAIL_ENDPOINT = /naukri/listings/{listing_id}
NAUKRI_REQUEST_TIMEOUT = 30
NAUKRI_RETRY_ATTEMPTS = 2
NAUKRI_CACHE_ENABLED = true
NAUKRI_CACHE_TTL = 300

# Cashify Configuration
CASHIFY_CONNECTOR_MODE = authorized_http
CASHIFY_AUTHORIZED_API_BASE_URL = http://127.0.0.1:8000
CASHIFY_SEARCH_ENDPOINT = /cashify/listings
CASHIFY_DETAIL_ENDPOINT = /cashify/listings/{listing_id}
CASHIFY_REQUEST_TIMEOUT = 30
CASHIFY_RETRY_ATTEMPTS = 2
CASHIFY_CACHE_ENABLED = true
CASHIFY_CACHE_TTL = 300

LISTINGS_PERSIST_ENABLED = false
EXPOSE_SOURCE_RAW_DATA = false
SOURCE_COLLECTION_TIMEZONE = Asia/Kolkata

